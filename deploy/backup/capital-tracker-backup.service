[Unit]
Description=Capital Tracker scheduled encrypted PostgreSQL backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
# Paths and retention; see deploy/backup/README.md.
Environment=RELEASE_ROOT=/opt/capital-tracker
Environment=BACKUP_RETENTION_DAYS=30
Environment=BACKUP_KEEP_MIN=7
Environment=BACKUP_METRICS_DIR=/var/lib/node_exporter/textfile_collector
ExecStart=/usr/local/sbin/capital-tracker-scheduled-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

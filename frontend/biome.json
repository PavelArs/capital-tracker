{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noVar": "error"
      },
      "a11y": {
        "preset": "none"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn"
      },
      "complexity": {
        "noForEach": "warn"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "off",
        "useImportType": "off"
      }
    }
  },
  "files": {
    "includes": ["**", "!**/dist/", "!**/node_modules/", "!**/coverage/"]
  },
  "overrides": [
    {
      "includes": ["**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ]
}

## Charts with Chart.js

### Reusable Chart Component

```typescript
// ✅ Good: Typed chart component
import { Line } from "react-chartjs-2";
import {
  Chart as ChartJS,
  CategoryScale,
  LinearScale,
  PointElement,
  LineElement,
  Title,
  Tooltip,
  Legend,
} from "chart.js";

ChartJS.register(
  CategoryScale,
  LinearScale,
  PointElement,
  LineElement,
  Title,
  Tooltip,
  Legend
);

interface LineChartProps {
  labels: string[];
  datasets: {
    label: string;
    data: number[];
    borderColor?: string;
    backgroundColor?: string;
  }[];
  title?: string;
}

export const LineChart: React.FC<LineChartProps> = ({
  labels,
  datasets,
  title,
}) => {
  const data = {
    labels,
    datasets: datasets.map((ds) => ({
      ...ds,
      tension: 0.4,
      fill: false,
    })),
  };

  const options = {
    responsive: true,
    plugins: {
      legend: { position: "top" as const },
      title: { display: !!title, text: title },
    },
  };

  return <Line data={data} options={options} />;
};
```

## Date Handling with date-fns

### Utility Functions

```typescript
// ✅ Good: Centralized date utilities
import { format, parseISO, isValid, formatDistance } from "date-fns";
import { ru, enUS } from "date-fns/locale";

const locales: Record<string, Locale> = { ru, en: enUS };

export const formatDate = (
  date: string | Date,
  formatStr = "dd.MM.yyyy",
  locale = "ru"
): string => {
  const parsedDate = typeof date === "string" ? parseISO(date) : date;
  if (!isValid(parsedDate)) return "";
  return format(parsedDate, formatStr, { locale: locales[locale] });
};

export const formatDateTime = (
  date: string | Date,
  locale = "ru"
): string => {
  return formatDate(date, "dd.MM.yyyy HH:mm", locale);
};

export const timeAgo = (date: string | Date, locale = "ru"): string => {
  const parsedDate = typeof date === "string" ? parseISO(date) : date;
  return formatDistance(parsedDate, new Date(), {
    addSuffix: true,
    locale: locales[locale],
  });
};
```

## Performance Optimization

### Memoization

```typescript
// ✅ Good: Proper use of useMemo and useCallback
const ExpensiveList: React.FC<{ items: Item[]; filter: string }> = ({
  items,
  filter,
}) => {
  // Memoize expensive computation
  const filteredItems = useMemo(
    () => items.filter((item) => item.name.includes(filter)),
    [items, filter]
  );

  // Memoize callback to prevent child re-renders
  const handleItemClick = useCallback((id: string) => {
    console.log("Clicked:", id);
  }, []);

  return (
    <ul>
      {filteredItems.map((item) => (
        <ListItem key={item.id} item={item} onClick={handleItemClick} />
      ))}
    </ul>
  );
};

// Memoize child component
const ListItem = React.memo<{ item: Item; onClick: (id: string) => void }>(
  ({ item, onClick }) => (
    <li onClick={() => onClick(item.id)}>{item.name}</li>
  )
);
```


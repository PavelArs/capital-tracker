{
  "name": "capital-tracker",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "argon2"
    ]
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.2.0",
    "@playwright/test": "1.63.0",
    "yaml": "2.8.1"
  },
  "engines": {
    "node": ">=22.21.1 <23",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "specs:validate": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "test:engineering": "pnpm --dir backend exec jest engineering/gates --runInBand",
    "lint": "pnpm --dir backend lint && pnpm --dir frontend lint",
    "build": "pnpm --dir backend build && pnpm --dir frontend build",
    "test": "pnpm --dir backend test --runInBand && pnpm --dir frontend test",
    "verify:baseline": "pnpm specs:validate && pnpm lint && pnpm build && pnpm test",
    "test:e2e": "node scripts/acceptance.mjs",
    "test:e2e:down": "node scripts/acceptance.mjs down"
  }
}

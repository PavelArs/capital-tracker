# Local Development Environment Configuration
# Copy this file to .env for local development:
# cp env.local.example .env
# Legacy local-service settings, not the isolated acceptance configuration.
# Cookie login additionally requires an HTTPS proxy; prefer pnpm test:e2e.

# Restart policy
RESTART_POLICY=no

# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=capital_tracker
DB_PORT_MAPPING=5432:5432

# Backend Configuration
BACKEND_IMAGE=capital-tracker-backend:local
BACKEND_PORT_MAPPING=3000:3000
NODE_ENV=development
# Frontend Configuration
FRONTEND_IMAGE=capital-tracker-frontend:local
FRONTEND_PORT_MAPPING=3001:80
# Exact browser HTTPS origin, no path/trailing slash; localhost is a different origin.
FRONTEND_URL=https://127.0.0.1:8443
# The HTTPS proxy must forward /api/ to the backend.
VITE_API_URL=/api

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PORT_MAPPING=6379:6379
EXCHANGE_RATES_CACHE_TTL=600000

# Current release images use /app/backend/dist and do not use source-code mounts.

# Required for backend startup and MFA CLI; deliberately no key/path/ID defaults.
# Absolute HOST path to a regular non-symlink file containing 32 raw key bytes.
# Compose binds it read-only at /run/secrets/ct-mfa-key and passes that process path.
# create_host_path:false requires the file to exist; protect its parent directory.
# File mode must be 0400 or 0600 and readable by the runtime identity (container UID 1000).
# Keep key outside repository/images/DB; mount read-only separately for backend and CLI.
MFA_KEY_FILE=
# Non-secret identifier: 1-64 ASCII letters, digits, underscores or hyphens.
MFA_KEY_ID=
# A separately launched CLI also needs the key mount and its absolute process path.

# Local Development Environment Configuration
# Copy this file to .env for local development:
# cp env.local.example .env

# Restart policy
RESTART_POLICY=no

# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=capital_tracker
DB_PORT_MAPPING=5432:5432

# Backend Configuration
BACKEND_IMAGE=capital-tracker-backend:local
BACKEND_PORT_MAPPING=3000:3000
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production

# Email Configuration (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-email@ethereal.email
SMTP_PASSWORD=your-app-password
SMTP_SECURE=false

# Development Invitation Code (works infinitely in dev environment only)
DEV_INVITATION_CODE=DEV2024

# Frontend Configuration
FRONTEND_IMAGE=capital-tracker-frontend:local
FRONTEND_PORT_MAPPING=3001:80
FRONTEND_URL=http://localhost:3001
VITE_API_URL=http://localhost:3000

# Development: Mount source code for hot reload
BACKEND_SOURCE_VOLUME=./backend:/app
BACKEND_NODE_MODULES_VOLUME=/app/node_modules
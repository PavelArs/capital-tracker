# Production Environment Configuration
# Copy this file to .env on production server and fill in the values:
# cp env.production.example .env
# nano .env  # Edit and set your actual values

# Restart policy
RESTART_POLICY=unless-stopped

# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=capital_tracker
# Don't expose PostgreSQL port externally in production
DB_PORT_MAPPING=127.0.0.1:5432:5432

# Registry Configuration (Yandex Cloud Container Registry)
# Get your REGISTRY_ID from Yandex Cloud Console
REGISTRY_ID=your-registry-id-here

# Backend Configuration
# Use registry image in production (built by CI/CD)
BACKEND_IMAGE=registry.yandexcloud.net/${REGISTRY_ID}/capital-tracker-backend:latest
BACKEND_PORT_MAPPING=127.0.0.1:3000:3000
NODE_ENV=production


# Frontend Configuration
FRONTEND_IMAGE=registry.yandexcloud.net/${REGISTRY_ID}/capital-tracker-frontend:latest
# Frontend on port 8080 for nginx proxy
FRONTEND_PORT_MAPPING=127.0.0.1:8080:80
FRONTEND_URL=https://pavelars.com
# Required JSON of verified exact backend socket peers; no assumed gateway/default.
# See docs/owner-authentication.md before changing the HTTP configuration.
TRUSTED_PROXY_IPS=
VITE_API_URL=https://api.pavelars.com

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
# Don't expose Redis port externally in production
REDIS_PORT_MAPPING=127.0.0.1:6379:6379
# Cache TTL for exchange rates (10 minutes = 600000ms)
EXCHANGE_RATES_CACHE_TTL=600000

# Production: Don't mount source code (use image content)
BACKEND_SOURCE_VOLUME=/app
BACKEND_NODE_MODULES_VOLUME=/dev/null

# Required for backend startup and MFA CLI; deliberately no key/path/ID defaults.
# Absolute HOST path to a regular non-symlink file containing 32 raw key bytes.
# Compose binds it read-only at /run/secrets/ct-mfa-key and passes that process path.
# create_host_path:false requires the file to exist; protect its parent directory.
# File mode must be 0400 or 0600 and readable by the runtime identity (container UID 1000).
# Keep key outside repository/images/DB; mount read-only separately for backend and CLI.
MFA_KEY_FILE=
# Non-secret identifier: 1-64 ASCII letters, digits, underscores or hyphens.
MFA_KEY_ID=
# Public rollout remains disabled; this legacy example is not a ready release procedure.
# A separately launched CLI also needs the key mount and its absolute process path.
# Free Etherscan API key (etherscan.io account, API Keys) for Ethereum wallets: ETH, USDT and
# USDC on mainnet. Keep it only in the private runtime file; without it Ethereum wallets
# report that the key is missing and Bitcoin wallets are unaffected.
ETHERSCAN_API_KEY=
# Optional free TronGrid API key (https://www.trongrid.io) for Tron wallets (TRX, USDT, USDC,
# staking). Tron wallets sync without it at TronGrid's lower keyless rate; with it they sync
# reliably. Keep it only in the private runtime file.
TRONGRID_API_KEY=
# Zcash wallets (M24): free NOWNodes key (nownodes.io, Start plan, no card) for its Blockbook
# at zecbook.nownodes.io. Without it the app asks Trezor's public instances, which answer 403
# to servers. Keep it only in the private runtime file.
ZCASH_BLOCKBOOK_API_KEY=
# Optional: another Blockbook REST address for Zcash (for example a GetBlock shared endpoint
# with the key in its path). It replaces the NOWNodes and Trezor addresses; the key is then
# part of this value, so keep it only in the private runtime file.
ZCASH_BLOCKBOOK_URL=
# Password reset email (M17) through Yandex SMTP (smtp.yandex.ru:465, implicit TLS): the full
# Yandex address and an app password created for "Mail" in Yandex ID security settings. The
# address is also the sender. Keep both only in the private runtime file; without them reset
# requests are answered as usual but no email is sent.
SMTP_USER=
SMTP_PASSWORD=

## Error Handling

### Custom Exception Filters

```typescript
// ✅ Good: Centralized error handling
@Catch()
export class GlobalExceptionFilter implements ExceptionFilter {
  constructor(private readonly logger: PinoLogger) {}

  catch(exception: unknown, host: ArgumentsHost) {
    const ctx = host.switchToHttp();
    const response = ctx.getResponse();
    const request = ctx.getRequest();

    const status =
      exception instanceof HttpException
        ? exception.getStatus()
        : HttpStatus.INTERNAL_SERVER_ERROR;

    const message =
      exception instanceof HttpException
        ? exception.message
        : "Internal server error";

    this.logger.error({
      statusCode: status,
      timestamp: new Date().toISOString(),
      path: request.url,
      method: request.method,
      error: exception,
    });

    response.status(status).json({
      statusCode: status,
      message,
      timestamp: new Date().toISOString(),
      path: request.url,
    });
  }
}
```

### Domain-Specific Exceptions

```typescript
// ✅ Good: Create custom exceptions for domain logic
export class UserNotFoundException extends NotFoundException {
  constructor(userId: string) {
    super(`User with ID ${userId} not found`);
  }
}

export class DuplicateEmailException extends ConflictException {
  constructor(email: string) {
    super(`User with email ${email} already exists`);
  }
}
```

## Service Layer Best Practices

### Single Responsibility

```typescript
// ✅ Good: Service with clear single responsibility
@Injectable()
export class UsersService {
  constructor(
    private readonly usersRepository: UsersRepository,
    private readonly logger: PinoLogger
  ) {
    this.logger.setContext(UsersService.name);
  }

  async findById(id: string): Promise<User> {
    const user = await this.usersRepository.findOne({ where: { id } });
    if (!user) {
      throw new UserNotFoundException(id);
    }
    return user;
  }

  async create(createUserDto: CreateUserDto): Promise<User> {
    const existingUser = await this.usersRepository.findOne({
      where: { email: createUserDto.email },
    });

    if (existingUser) {
      throw new DuplicateEmailException(createUserDto.email);
    }

    const user = this.usersRepository.create(createUserDto);
    return await this.usersRepository.save(user);
  }
}
```

### Separation of Concerns

```typescript
// ❌ Bad: Service doing too much
class UsersService {
  async createUser(dto: CreateUserDto) {
    // Validation in service (should be in DTO)
    if (!dto.email.includes("@")) throw new Error("Invalid email");

    // Direct DB queries (should be in repository)
    const user = await this.db.query("INSERT INTO users...");

    // Email sending (should be in separate service)
    await this.sendEmail(user.email);

    return user;
  }
}

// ✅ Good: Proper separation
@Injectable()
class UsersService {
  constructor(
    private readonly usersRepository: UsersRepository,
    private readonly emailService: EmailService,
    private readonly eventEmitter: EventEmitter2
  ) {}

  async create(dto: CreateUserDto): Promise<User> {
    const user = await this.usersRepository.save(
      this.usersRepository.create(dto)
    );

    // Async operations via events (loose coupling)
    this.eventEmitter.emit("user.created", new UserCreatedEvent(user));

    return user;
  }
}
```

## Repository Pattern

### Custom Repositories

```typescript
// ✅ Good: Custom repository with domain-specific methods
@Injectable()
export class UsersRepository extends Repository<User> {
  constructor(
    @InjectRepository(User)
    private readonly repository: Repository<User>
  ) {
    super(repository.target, repository.manager, repository.queryRunner);
  }

  async findByEmail(email: string): Promise<User | null> {
    return this.repository.findOne({ where: { email } });
  }

  async findActiveUsers(): Promise<User[]> {
    return this.repository.find({
      where: { isActive: true },
      order: { createdAt: "DESC" },
    });
  }

  async softDelete(id: string): Promise<void> {
    await this.repository.update(id, { deletedAt: new Date() });
  }
}
```

## TypeORM Best Practices

### Entity Design

```typescript
// ✅ Good: Well-structured entity
@Entity("users")
export class User {
  @PrimaryGeneratedColumn("uuid")
  id: string;

  @Column({ unique: true })
  @Index()
  email: string;

  @Column({ select: false }) // Never select password by default
  password: string;

  @Column()
  name: string;

  @CreateDateColumn({ name: "created_at" })
  createdAt: Date;

  @UpdateDateColumn({ name: "updated_at" })
  updatedAt: Date;

  @DeleteDateColumn({ name: "deleted_at" })
  deletedAt: Date | null;

  // Use relations carefully - consider lazy loading for microservices
  @OneToMany(() => Order, (order) => order.user, { lazy: true })
  orders: Promise<Order[]>;
}
```

### Query Optimization

```typescript
// ✅ Good: Efficient queries
class UsersService {
  // Use select to fetch only needed fields
  async findUserSummary(id: string): Promise<UserSummaryDto> {
    return this.repository
      .createQueryBuilder("user")
      .select(["user.id", "user.name", "user.email"])
      .where("user.id = :id", { id })
      .getOne();
  }

  // Use pagination for large datasets
  async findAll(page: number, limit: number): Promise<[User[], number]> {
    return this.repository.findAndCount({
      skip: (page - 1) * limit,
      take: limit,
      order: { createdAt: "DESC" },
    });
  }

  // Use transactions for multi-step operations
  async transferBalance(fromId: string, toId: string, amount: number) {
    return this.repository.manager.transaction(async (manager) => {
      const fromUser = await manager.findOne(User, { where: { id: fromId } });
      const toUser = await manager.findOne(User, { where: { id: toId } });

      fromUser.balance -= amount;
      toUser.balance += amount;

      await manager.save([fromUser, toUser]);
    });
  }
}
```

### Migrations

```typescript
// ✅ Good: Always use migrations for schema changes
// Never use synchronize: true in production
// Generate migrations: npm run migration:generate
// Run migrations: npm run migration:run

export class CreateUsersTable1234567890123 implements MigrationInterface {
  public async up(queryRunner: QueryRunner): Promise<void> {
    await queryRunner.createTable(
      new Table({
        name: "users",
        columns: [
          {
            name: "id",
            type: "uuid",
            isPrimary: true,
            default: "uuid_generate_v4()",
          },
          {
            name: "email",
            type: "varchar",
            isUnique: true,
          },
          // ... other columns
        ],
      }),
      true
    );

    await queryRunner.createIndex(
      "users",
      new TableIndex({
        name: "IDX_USERS_EMAIL",
        columnNames: ["email"],
      })
    );
  }

  public async down(queryRunner: QueryRunner): Promise<void> {
    await queryRunner.dropTable("users");
  }
}
```

## API Design

### RESTful Controllers

```typescript
// ✅ Good: Clean, RESTful controller
@Controller("users")
@ApiTags("users")
export class UsersController {
  constructor(private readonly usersService: UsersService) {}

  @Post()
  @HttpCode(HttpStatus.CREATED)
  @ApiOperation({ summary: "Create a new user" })
  @ApiResponse({ status: 201, type: UserResponseDto })
  async create(@Body() createUserDto: CreateUserDto): Promise<UserResponseDto> {
    const user = await this.usersService.create(createUserDto);
    return plainToInstance(UserResponseDto, user);
  }

  @Get(":id")
  @ApiOperation({ summary: "Get user by ID" })
  @ApiParam({ name: "id", type: "string" })
  async findOne(@Param("id") id: string): Promise<UserResponseDto> {
    const user = await this.usersService.findById(id);
    return plainToInstance(UserResponseDto, user);
  }

  @Patch(":id")
  async update(
    @Param("id") id: string,
    @Body() updateUserDto: UpdateUserDto
  ): Promise<UserResponseDto> {
    const user = await this.usersService.update(id, updateUserDto);
    return plainToInstance(UserResponseDto, user);
  }

  @Delete(":id")
  @HttpCode(HttpStatus.NO_CONTENT)
  async remove(@Param("id") id: string): Promise<void> {
    await this.usersService.remove(id);
  }
}
```


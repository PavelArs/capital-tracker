## Performance Optimization

### Caching Strategy

```typescript
// ✅ Good: Strategic caching for expensive operations
@Injectable()
export class UsersService {
  private readonly cache = new Map<string, User>();

  async findById(id: string): Promise<User> {
    // Check cache first
    const cached = this.cache.get(id);
    if (cached) {
      return cached;
    }

    const user = await this.usersRepository.findOne({ where: { id } });
    if (!user) {
      throw new UserNotFoundException(id);
    }

    this.cache.set(id, user);
    return user;
  }

  async update(id: string, dto: UpdateUserDto): Promise<User> {
    const user = await this.usersRepository.update(id, dto);
    this.cache.delete(id); // Invalidate cache
    return user;
  }
}
```

### Async Operations

```typescript
// ✅ Good: Use events for async operations
@Injectable()
export class UsersService {
  constructor(private readonly eventEmitter: EventEmitter2) {}

  async create(dto: CreateUserDto): Promise<User> {
    const user = await this.usersRepository.save(
      this.usersRepository.create(dto)
    );

    // Non-blocking operations via events
    this.eventEmitter.emit("user.created", new UserCreatedEvent(user));

    return user;
  }
}

@Injectable()
export class UserEventsListener {
  @OnEvent("user.created")
  async handleUserCreated(event: UserCreatedEvent) {
    // Send welcome email, create related records, etc.
    await this.emailService.sendWelcomeEmail(event.user);
  }
}
```

## Microservices Preparation

### Interface-Based Design

```typescript
// ✅ Good: Define interfaces for inter-service communication
export interface IUsersService {
  findById(id: string): Promise<UserDto>;
  create(dto: CreateUserDto): Promise<UserDto>;
  update(id: string, dto: UpdateUserDto): Promise<UserDto>;
}

// Implementation can be swapped for gRPC/TCP later
@Injectable()
export class UsersService implements IUsersService {
  // Implementation
}
```

### Message Patterns for Events

```typescript
// ✅ Good: Use event patterns ready for message queues
export const USER_EVENTS = {
  CREATED: "user.created",
  UPDATED: "user.updated",
  DELETED: "user.deleted",
} as const;

// Can be easily migrated to RabbitMQ/Kafka
this.eventEmitter.emit(USER_EVENTS.CREATED, payload);
```

### Avoid Direct Module Dependencies

```typescript
// ❌ Bad: Direct dependency between modules
class OrdersService {
  constructor(private readonly usersService: UsersService) {}
}

// ✅ Good: Use events or shared interfaces
class OrdersService {
  constructor(private readonly eventEmitter: EventEmitter2) {}

  async create(dto: CreateOrderDto) {
    const order = await this.ordersRepository.save(dto);

    // Loose coupling via events
    this.eventEmitter.emit("order.created", {
      orderId: order.id,
      userId: order.userId,
    });
  }
}
```


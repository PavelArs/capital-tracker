## Logging Best Practices

### Structured Logging with Pino

```typescript
// ✅ Good: Structured logging with context
@Injectable()
export class UsersService {
  constructor(private readonly logger: PinoLogger) {
    this.logger.setContext(UsersService.name);
  }

  async create(dto: CreateUserDto): Promise<User> {
    this.logger.info({ email: dto.email }, "Creating new user");

    try {
      const user = await this.usersRepository.save(
        this.usersRepository.create(dto)
      );

      this.logger.info({ userId: user.id }, "User created successfully");
      return user;
    } catch (error) {
      this.logger.error(
        { error: error.message, email: dto.email },
        "Failed to create user"
      );
      throw error;
    }
  }
}
```

## Testing Best Practices

### Unit Tests

```typescript
// ✅ Good: Comprehensive unit test
describe("UsersService", () => {
  let service: UsersService;
  let repository: MockType<UsersRepository>;

  beforeEach(async () => {
    const module: TestingModule = await Test.createTestingModule({
      providers: [
        UsersService,
        {
          provide: UsersRepository,
          useFactory: () => ({
            findOne: jest.fn(),
            save: jest.fn(),
            create: jest.fn(),
          }),
        },
      ],
    }).compile();

    service = module.get<UsersService>(UsersService);
    repository = module.get(UsersRepository);
  });

  describe("findById", () => {
    it("should return user when found", async () => {
      const user = { id: "1", email: "test@example.com" };
      repository.findOne.mockResolvedValue(user);

      const result = await service.findById("1");

      expect(result).toEqual(user);
      expect(repository.findOne).toHaveBeenCalledWith({ where: { id: "1" } });
    });

    it("should throw UserNotFoundException when user not found", async () => {
      repository.findOne.mockResolvedValue(null);

      await expect(service.findById("1")).rejects.toThrow(
        UserNotFoundException
      );
    });
  });
});
```


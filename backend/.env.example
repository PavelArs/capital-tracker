# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=capital_tracker
# Server Configuration
PORT=3000
NODE_ENV=development

# Exact HTTPS browser origin for CORS and protected writes (no trailing slash/path).
# HTTP watch-server ports alone do not support Secure-cookie login.
FRONTEND_URL=https://127.0.0.1:8443
# Required JSON of exact HTTPS proxy socket peers; [] selects explicit direct mode.
# See docs/owner-authentication.md. Never use a broad trusted subnet.
TRUSTED_PROXY_IPS=

# No public signup or email reset. Provision the owner with the CLI after migration.
# See docs/owner-authentication.md. Login requires HTTPS and confirmed CLI MFA enrollment.

# Required for backend startup and MFA CLI; deliberately no key/path/ID defaults.
# Absolute process path to a regular non-symlink file containing 32 raw key bytes.
# File mode must be 0400 or 0600 and readable by the runtime identity (container UID 1000).
# Keep key outside repository/images/DB; mount read-only separately for backend and CLI.
MFA_KEY_FILE=
# Non-secret identifier: 1-64 ASCII letters, digits, underscores or hyphens.
MFA_KEY_ID=

# Optional indicative personal USD/EUR/RUB display, no key or paid fallback.
# Off by default. Enabled collector reserves at most3 attempts in any24h in PostgreSQL.
DISPLAY_FX_ENABLED=false
# Direct mode validates public DNS destinations and ignores proxy environment vars.
# Set true only for a trusted, target-validating HTTP(S) egress proxy configured via
# HTTPS_PROXY (or HTTP_PROXY/ALL_PROXY). This delegates upstream DNS enforcement.
DISPLAY_FX_TRUST_PROXY=false

# Hourly crypto prices from Kraken and CoinGecko public APIs (no paid key), stored in
# price_observations, and daily Bank of Russia USD/EUR rates (cbr.ru XML_dynamic,
# backfilled from 2025-01-01) stored in fx_rates; the same switch runs the hourly
# background sync of wallet addresses (public Esplora). Independent of
# BACKGROUND_JOBS_ENABLED. Off by default.
PRICE_COLLECTION_ENABLED=false
# Optional free CoinGecko Demo key, sent as x-cg-demo-api-key; keyless works too.
COINGECKO_DEMO_API_KEY=

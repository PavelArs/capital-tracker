{
  "name": "capital-tracker-backend",
  "version": "1.0.0",
  "description": "Backend for personal capital tracking application",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check --write src/",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "migration:run": "node dist/migrate.js",
    "migration:show": "node dist/migrate.js show",
    "owner:bootstrap": "node dist/owner-cli.js bootstrap",
    "owner:recover": "node dist/owner-cli.js recover"
  },
  "dependencies": {
    "@keyv/redis": "^6.1.0",
    "@nestjs/cache-manager": "12.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "argon2": "0.45.1",
    "axios": "1.20.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "2.5.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "10.1.4",
    "otpauth": "9.5.2",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.ts",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/typeorm-data-source.ts",
      "!**/migrations/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
